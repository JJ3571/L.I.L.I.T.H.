# Discord Bot Sandbox — environment template
#
# Copy this file to `.env` in the same directory as docker-compose.yml.
# Do not commit real secrets.
#
# Docker Compose reads `.env` for ${VAR} substitution.
# Operator entry point: ./scripts/bot.sh up
#
# Full key reference: docs/CONFIGURATION.md

# =============================================================================
# REQUIRED — the bot will not start without these three keys
# =============================================================================
DISCORD_BOT_TOKEN=
APPLICATION_ID=
GUILD_ID=

# =============================================================================
# DATABASE — bundled Postgres is the default (no edit required)
# =============================================================================
# Leave DATABASE_URL empty. The compose file substitutes the bundled host
# `postgres` when COMPOSE_PROFILES includes bundled-db.
DATABASE_URL=

# To use an external database instead:
#   1. Set COMPOSE_PROFILES=   (empty — omit bundled-db)
#   2. Set DATABASE_URL to your Postgres URL, for example:
# DATABASE_URL=postgresql://user:password@db.example.com/neondb?sslmode=require

COMPOSE_PROFILES=bundled-db

POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_DB=discord_bot
POSTGRES_HOST_PORT=5432

# Optional pgAdmin UI. Enable with: COMPOSE_PROFILES=bundled-db,admin-ui
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=changeme
PGADMIN_HOST_PORT=5050

# =============================================================================
# OPTIONAL — runtime toggles (main_bot.main)
# =============================================================================
# Truthy: 1, true, yes, on    Falsy: 0, false, no, off
# Leave blank to use the Python defaults.

# Load development cogs after production cogs. Unset → True in main.py.
LOAD_DEVELOPMENT_COGS=

# Verbose [DEBUG] lines on stdout from selected cogs. Unset → false.
FULL_DEBUG_IN_TERMINAL=

# Nextcord logger level in the combined runtime file. Default INFO.
NEXTCORD_FILE_LOG_LEVEL=

# App log subtree main_bot.* in that same file. Default INFO.
APP_LOG_LEVEL=

# When true (default), boot and cog logs also echo to stdout.
APP_LOG_STDOUT_MIRROR=

# =============================================================================
# OPTIONAL — deployment, Lavalink, local music HTTP
# =============================================================================
ENVIRONMENT=production

# Lavalink HTTP API password. Must match lavalink/application.yml server.password.
# For host Python runs, point LAVALINK_URI at localhost when Lavalink listens on the host:
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass

# YouTube OAuth for the Lavalink container (youtube-plugin). Not read by the Python bot.
YOUTUBE_OAUTH_ENABLED=false
# YOUTUBE_OAUTH_REFRESH_TOKEN=

# Docker Compose substitution only. When unset, Compose sets bot
# LAVALINK_URI=http://lavalink:2333. Set only for Lavalink outside Compose.
# LAVALINK_DOCKER_URI=http://other-hostname:2333

# Loopback HTTP that serves local_audio/music to Lavalink.
MUSIC_LOCAL_HTTP_HOST=127.0.0.1
# Optional aiohttp bind. Docker Compose typically needs 0.0.0.0 here while
# MUSIC_LOCAL_HTTP_HOST is the Compose service hostname (often bot).
MUSIC_LOCAL_HTTP_BIND_HOST=
MUSIC_LOCAL_HTTP_PORT=8765

# JSON array of voice channel IDs where slash music controls are blocked.
MUSIC_VOICE_CHANNEL_DENYLIST=[]
# MUSIC_DEFAULT_PLAYER_VOLUME=50

# Optional: flat folders under local_audio/music/{MUSIC_FOLDER_n} register a
# /{name} slash command. Slots 1–25. Empty = skip. Reserved: gaming, brainrot.
# MUSIC_FOLDER_1=jazz
# MUSIC_1_SHUFFLE_START=true
# MUSIC_FOLDER_2=lofi

# =============================================================================
# OPTIONAL — admin logging and image search
# =============================================================================
# Docker Compose defaults BOT_LOG_FILE to /app/logs/discord_bot.log and mounts
# ./logs. Inspect logs on the host under ./logs/.
BOT_LOG_JOURNAL_UNIT=
BOT_LOG_JOURNAL_EXTRA_UNITS=
BOT_LOG_FILE=
BOT_LOG_MAX_BYTES=
BOT_LOG_BACKUP_COUNT=

BRAVE_IMAGE_SEARCH_MIN_INTERVAL=
BRAVE_TIERLIST_IMAGE_MIN_HEIGHT=
BRAVE_TIERLIST_IMAGE_MIN_WIDTH=

SERPENT_API_KEY=
SERPENT_IMAGE_SEARCH_MIN_INTERVAL=
SERPENT_IMAGE_ENGINE=google
# Optional: serpent or brave to force a provider when both keys are set.
TIERLIST_IMAGE_ENGINE=

# =============================================================================
# OPTIONAL — Crafty Controller
# =============================================================================
CRAFTY_BASE_URL=
CRAFTY_USERNAME=
CRAFTY_PASSWORD=

# =============================================================================
# OPTIONAL — admin and error alerts
# =============================================================================
ADMIN_USER_IDS=[]
ERROR_ALERT_USER_ID=0
ERROR_ALERT_CHANNEL_ID=0

# =============================================================================
# OPTIONAL — channels and categories
# =============================================================================
BOT_SPAM_ID=0
VOICE_CHANNEL_IDS=[]
CREATE_FIRETEAM_CHANNEL_ID=0
WATCH_PARTY_CHANNEL_ID=0
WATCH_PARTY_EVENT_ID=0
LEAGUE_CHANNEL_ID=0
BACKUP_CHANNEL_ID=0
AFK_CHANNEL_ID=0

SEEN_CATEGORY_ID=0
HIDDEN_CATEGORY_ID=0
WATERBOARD_CATEGORY_ID=0

# =============================================================================
# OPTIONAL — emojis and birthdays
# =============================================================================
HEADS_EMOJI_ID=0
TAILS_EMOJI_ID=0
COIN_EMOJI_ID=0

BIRTHDAY_ANNOUNCEMENT_CHANNEL_ID=0
BIRTHDAY_REACTION_CHANNEL_ID=0
BIRTHDAY_ROLE_ID=0
BIRTHDAY_EMOJI_ID=0
BIRTHDAY_CHANNEL_ID=0

# =============================================================================
# OPTIONAL — MTG autocard / TCG / Say
# =============================================================================
MTG_AUTOLINK_CHANNEL_IDS=[]
MTG_AUTOLINK_COOLDOWN_CHANNEL_IDS=[]
MTG_AUTOLINK_BLOCKED_NAMES=[]
MTG_AUTOLINK_MAX_CARDS_PER_MESSAGE=5
MTG_AUTOLINK_MAX_WORD_SPAN=4

MANA_SYMBOLS={}

# =============================================================================
# OPTIONAL — external APIs and OpenCode Go (Say cog LLM)
# =============================================================================
OPENCODE_API_KEY=
# OpenCode Go model id (for example glm-5.3-flash, kimi-k2.6, qwen3.6-plus)
OPENCODE_MODEL=glm-5.3-flash
OMDB_API_KEY=
OMDB_API_URL=
BRAVE_SEARCH_API_KEY=

# =============================================================================
# OPTIONAL — Say / webhook config
# =============================================================================
WEBHOOK_URL=
CHARACTER_AVATARS={}
ZERONI_REACTION_EMOJI=
COMMUNITY_NOTES_REACTION_EMOJI=
